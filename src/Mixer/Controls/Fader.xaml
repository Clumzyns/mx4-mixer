<UserControl x:Class="Mixer.Controls.Fader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <UserControl.Resources>
    <Style x:Key="Repeat" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid x:Name="VerticalLayout">
      <Border x:Name="VGroove" Width="4" HorizontalAlignment="Center" CornerRadius="2" Background="#2A3140"/>
      <Border x:Name="VFill" Width="4" HorizontalAlignment="Center" VerticalAlignment="Bottom" CornerRadius="2" Background="#B6F23A" IsHitTestVisible="False"/>
      <Slider x:Name="VSlider" Orientation="Vertical" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
              IsDirectionReversed="True" IsMoveToPointEnabled="True"
              Value="{Binding Value, ElementName=Root, Mode=TwoWay}">
        <Slider.Template>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Repeat}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Repeat}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="22" Height="10" Focusable="False" OverridesDefaultStyle="True">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#B6F23A" CornerRadius="3" Width="22" Height="10"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Slider.Template>
      </Slider>
    </Grid>
    <Grid x:Name="HorizontalLayout" Visibility="Collapsed" Height="18">
      <Border x:Name="HGroove" Height="4" VerticalAlignment="Center" CornerRadius="2" Background="#2A3140"/>
      <Border x:Name="HFill" Height="4" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="#B6F23A" IsHitTestVisible="False"/>
      <Slider x:Name="HSlider" Orientation="Horizontal" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
              IsMoveToPointEnabled="True"
              Value="{Binding Value, ElementName=Root, Mode=TwoWay}">
        <Slider.Template>
          <ControlTemplate TargetType="Slider">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Repeat}" Command="Slider.DecreaseLarge"/>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Repeat}" Command="Slider.IncreaseLarge"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="10" Height="16" Focusable="False" OverridesDefaultStyle="True">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="#B6F23A" CornerRadius="3" Width="10" Height="16"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Slider.Template>
      </Slider>
    </Grid>
  </Grid>
</UserControl>
