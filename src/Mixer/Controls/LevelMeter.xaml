<UserControl x:Class="Mixer.Controls.LevelMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
  <Grid>
    <Border x:Name="Track" Background="#0A0C0E" CornerRadius="3"/>
    <Border x:Name="Fill" Background="#B6F23A" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
  </Grid>
</UserControl>
