<Window x:Class="Mixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mixer.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Mixer"
        Icon="pack://application:,,,/Assets/mixer.ico"
        Width="1240" Height="800"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource InterFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="8"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="LayoutRoot">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Height="40" Margin="12,0,4,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="22" Height="22" Margin="0,0,10,0">
          <Border Background="#B6F23A" CornerRadius="6"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="2" Height="10" Background="#14180A" Margin="0.5,0" VerticalAlignment="Bottom"/>
            <Border Width="2" Height="6" Background="#14180A" Margin="0.5,0" VerticalAlignment="Bottom"/>
            <Border Width="2" Height="12" Background="#14180A" Margin="0.5,0" VerticalAlignment="Bottom"/>
          </StackPanel>
        </Grid>
        <TextBlock Text="Mixer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
        <TextBlock Text="OUTPUT" Foreground="{StaticResource FaintBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="OutputCombo" Width="240" ItemsSource="{Binding OutputChoices}" SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedOutputId, Mode=OneWay}" SelectionChanged="OutputCombo_SelectionChanged"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Windows default playback device"/>
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
        <TextBlock Text="INPUT" Foreground="{StaticResource FaintBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="InputCombo" Width="220" ItemsSource="{Binding InputDevices}" SelectedValuePath="Id"
                  SelectedValue="{Binding SelectedInputId, Mode=OneWay}" SelectionChanged="InputCombo_SelectionChanged"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Windows default microphone"/>
        <controls:LevelMeter Width="64" Height="8" Margin="10,0,8,0" VerticalAlignment="Center" Orientation="Horizontal" Value="{Binding MicPeak}"/>
        <Button Style="{StaticResource MicButton}" Content="{Binding MicMuteLabel}" Command="{Binding ToggleMicCommand}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Mute the microphone"/>
      </StackPanel>

      <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
        <Button Style="{StaticResource ChromeButton}" Content="⚙" ToolTip="Settings" Click="Settings_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Style="{StaticResource ChromeButton}" Content="—" ToolTip="Minimize to tray" Click="Minimize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Style="{StaticResource ChromeButton}" Content="▢" ToolTip="Maximize" Click="Maximize_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button Style="{StaticResource CloseButton}" Content="✕" ToolTip="Close to tray" Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Margin="16,0,16,8" Padding="12,8" Background="#14181F" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
          <Ellipse.Style>
            <Style TargetType="Ellipse">
              <Setter Property="Fill" Value="#5C6573"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ChatMixConnected}" Value="True">
                  <Setter Property="Fill" Value="#B6F23A"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Ellipse.Style>
        </Ellipse>
        <TextBlock Grid.Column="1" Text="CHATMIX" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <CheckBox Grid.Column="2" Content="On" IsChecked="{Binding ChatMixEnabled}" Margin="0,0,14,0" VerticalAlignment="Center" ToolTip="Read the Nova Pro dial and drive the Game and Chat faders"/>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" FontSize="12">
          <Run Text="{Binding ChatMixReadout, Mode=OneWay}" FontWeight="SemiBold" Foreground="#F2F4F6"/>
          <Run Text="   "/>
          <Run Text="{Binding ChatMixDetail, Mode=OneWay}"/>
        </TextBlock>
      </Grid>
    </Border>

    <Border Grid.Row="2" Margin="16,0,16,8" Padding="12,8" Background="#2A2414" BorderBrush="#FFC56A" BorderThickness="1" CornerRadius="12"
            Visibility="{Binding ShowSonarWarning, Converter={StaticResource BoolVis}}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding SonarWarning}" TextWrapping="Wrap" Foreground="#FFC56A" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Close SteelSeries" Margin="12,0,0,0"
                Command="{Binding CloseSonarCommand}"/>
      </Grid>
    </Border>

    <ScrollViewer x:Name="ColumnScroll" Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,0,10,0" SizeChanged="ColumnScroll_SizeChanged">
      <ItemsControl x:Name="ColumnHost" ItemsSource="{Binding Channels}" MinWidth="1120">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
          <Style TargetType="ContentPresenter">
            <Setter Property="Margin" Value="6,0"/>
          </Style>
        </ItemsControl.ItemContainerStyle>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border AllowDrop="True" DragOver="Channel_DragOver" DragLeave="Channel_DragLeave" Drop="Channel_Drop">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="#14181F"/>
                  <Setter Property="BorderBrush" Value="#2A3140"/>
                  <Setter Property="BorderThickness" Value="1"/>
                  <Setter Property="CornerRadius" Value="16"/>
                  <Setter Property="MinWidth" Value="200"/>
                  <Setter Property="SnapsToDevicePixels" Value="True"/>
                  <Style.Triggers>
                    <Trigger Property="Tag" Value="over">
                      <Setter Property="BorderBrush" Value="#B6F23A"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid Margin="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*" MinHeight="160"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="190"/>
                </Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse Width="8" Height="8" Fill="{Binding Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource FaintBrush}" FontSize="11"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding AppCountLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
                <ComboBox Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding DataContext.OutputChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValuePath="Id" SelectedValue="{Binding DeviceId, Mode=OneWay}" SelectionChanged="ChannelDevice_SelectionChanged"
                          ToolTip="Default follows the master output"/>
                <Grid Grid.Row="2" Margin="0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <controls:LevelMeter Value="{Binding Peak}" Margin="0,6,0,6"/>
                  <controls:Fader Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" IsMuted="{Binding Muted}" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource MuteButton}" Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" Margin="0"/>
                  <TextBlock Grid.Column="1" Text="{Binding VolumeLabel}" FontSize="18" FontWeight="SemiBold" Margin="12,8,0,0"
                             VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Foreground="{StaticResource AccentBrush}"/>
                </Grid>
                <Grid Grid.Row="4" Margin="0,8,0,0">
                  <TextBlock Text="Drop an app here" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsHitTestVisible="False" Visibility="{Binding HasApps, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Apps}">
                      <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                          <Setter Property="Margin" Value="0,0,0,8"/>
                        </Style>
                      </ItemsControl.ItemContainerStyle>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="#1C222C" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="10" Padding="8"
                                  PreviewMouseLeftButtonDown="Chip_PreviewMouseLeftButtonDown"
                                  PreviewMouseMove="Chip_PreviewMouseMove"
                                  PreviewMouseLeftButtonUp="Chip_PreviewMouseLeftButtonUp"
                                  ToolTip="Drag onto a channel, or pick one below">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Grid Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Top">
                                <Border Background="#0D0F12" CornerRadius="6" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                  <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B6F23A" FontWeight="SemiBold"/>
                                </Border>
                                <Image Source="{Binding Icon}" Width="28" Height="28" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}}"/>
                              </Grid>
                              <StackPanel Grid.Column="1">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                  <Button Grid.Column="1" Style="{StaticResource MuteButton}" Content="{Binding MuteLabel}" Command="{Binding ToggleMuteCommand}" Padding="8,2" Margin="8,0,0,0" MinWidth="52"/>
                                </Grid>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource FaintBrush}" FontSize="11" Margin="0,2,0,6"/>
                                <ComboBox ItemsSource="{Binding DataContext.ChannelChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedValuePath="Id" SelectedValue="{Binding Channel, Mode=OneWay}" SelectionChanged="ChipChannel_SelectionChanged"/>
                                <controls:Fader Orientation="Horizontal" Height="18" Margin="0,8,0,2" Value="{Binding BaseVolume, Mode=TwoWay}" IsMuted="{Binding Muted}"/>
                                <controls:LevelMeter Height="4" Margin="0,4,0,0" Orientation="Horizontal" Value="{Binding Peak}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <Grid Grid.Row="4" Margin="20,6,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
        <Ellipse.Style>
          <Style TargetType="Ellipse">
            <Setter Property="Fill" Value="#5C6573"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding RoutingAvailable}" Value="True">
                <Setter Property="Fill" Value="#B6F23A"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Ellipse.Style>
      </Ellipse>
      <TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="10,0,12,0"/>
      <TextBlock Grid.Column="2" Text="Saved in %APPDATA%\Mixer" Foreground="{StaticResource FaintBrush}" FontSize="12" VerticalAlignment="Center" ToolTip="{Binding ConfigPath}"/>
    </Grid>

    <Border Grid.RowSpan="5" Background="#C00D0F12" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVis}}" MouseLeftButtonDown="SettingsBackdrop_MouseDown">
      <Border HorizontalAlignment="Right" Width="380" Background="#14181F" BorderBrush="#2A3140" BorderThickness="1,0,0,0" MouseLeftButtonDown="EatClick">
        <StackPanel Margin="24">
          <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding VersionText}" Foreground="{StaticResource FaintBrush}" Margin="0,4,0,16"/>
          <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
          <CheckBox Content="Start minimized to the tray" IsChecked="{Binding StartMinimized}"/>
          <Button Style="{StaticResource GhostButton}" Content="Open config folder" Command="{Binding OpenConfigCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18,0,0"
                     Text="Default on a channel follows the master output. Pick a device on the channel to send every app in it there. New audio follows the channel; a stream that is already playing may stay put until the app opens another one."/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,0"
                     Text="Discord, TeamSpeak, Spotify, Chrome, Firefox, Edge, and VLC land in Chat or Media the first time they play. Drag a chip, or use its menu, to move it. The choice is remembered by the program name."/>
          <Button Style="{StaticResource GhostButton}" Content="Close" HorizontalAlignment="Left" Margin="0,20,0,0" Click="Settings_Click"/>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.Row="3" Margin="16" Background="#E614181F" BorderBrush="#2A3140" BorderThickness="1" CornerRadius="16" Padding="24"
            Visibility="{Binding NoOutputs, Converter={StaticResource BoolVis}}" IsHitTestVisible="False">
      <TextBlock Text="No playback devices found. Plug in your IEMs and Mixer will list them here." FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
    </Border>
  </Grid>
</Window>
